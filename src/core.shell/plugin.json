{
  "id": "core.shell",
  "name": "应用外壳",
  "version": "0.4.2",
  "versionCode": 9,
  "kind": "core",
  "entry": "main.js",
  "apiVersion": 1,
  "description": "悬浮底部导航栏 + 页面插槽。四 tab 使用 Rounded 圆角面型图标（会话=圆气泡、发现=指南针）；选中态浅绿；底栏距底部 30dp；声明 dock:'bottom'，随可滚动页面上下拖动跟手收起/显现，松手补完；「会话」图标右上角小圆角标；二级页自动隐藏底栏。",
  "author": "NianFengChat",
  "activation": [
    "startup",
    "view:app.shell"
  ],
  "deps": [],
  "permissions": [],
  "contributes": {
    "views": [
      {
        "id": "app.shell",
        "title": "外壳",
        "keepAlive": true
      }
    ],
    "navTabs": [
      {
        "id": "chat",
        "view": "chatlist",
        "label": "会话",
        "icon": "chat",
        "iconActive": "chat",
        "order": 10
      },
      {
        "id": "contacts",
        "view": "contacts",
        "label": "通讯录",
        "icon": "contacts",
        "iconActive": "contacts",
        "order": 20
      },
      {
        "id": "moments",
        "view": "moments",
        "label": "发现",
        "icon": "discover",
        "iconActive": "discover",
        "order": 30
      },
      {
        "id": "me",
        "view": "me",
        "label": "我",
        "icon": "me",
        "iconActive": "me",
        "order": 40
      }
    ],
    "stages": []
  }
}
